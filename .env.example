# 复制为 .env 后修改
# 生成方式：python -c "import secrets;print(secrets.token_urlsafe(48))"
ERP_SECRET_KEY=
# 店铺授权凭证加密密钥（Fernet，可选；为空则由 SECRET_KEY 派生，修改 SECRET_KEY 会导致已保存的凭证无法解密）
# 生成方式：python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
ERP_ENCRYPTION_KEY=
DB_PASSWORD=erp_password_change_me
ERP_PORT=8000
ERP_ALLOW_REGISTRATION=true
ERP_SEED_DEMO=false
